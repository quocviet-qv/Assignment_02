<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Question Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container">
        <a class="navbar-brand" href="#">SimpleQuiz App</a>
        <div class="collapse navbar-collapse">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link" href="/ui/quizzes">Quizzes Management</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/ui/questions">Questions Management</a>
                </li>
            </ul>
        </div>
    </div>
</nav>
    <div class="container mt-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>Questions</h1>
            <a href="/ui/questions/create" class="btn btn-primary">Create New Question</a>
        </div>
        
        <div class="list-group shadow-sm">
            <% questions.forEach(function(question) { %>
                <div class="list-group-item d-flex justify-content-between align-items-center p-3">
                    <div>
                        <!-- Tuỳ thuộc vào model Question của bạn, ở đây dùng 'text' đại diện cho nội dung -->
                        <h5 class="mb-1 text-primary"><%= question.text || question.questionText || 'Câu hỏi chưa có nội dung' %></h5>
                    </div>
                    <div>
                        <a href="/ui/questions/<%= question._id %>/edit" class="btn btn-sm btn-warning text-dark">Edit</a>
                        <form action="/ui/questions/<%= question._id %>?_method=DELETE" method="POST" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Xóa câu hỏi này?')">Delete</button>
                        </form>
                    </div>
                </div>
            <% }); %>

            <% if (questions.length === 0) { %>
                <div class="list-group-item text-center text-muted p-4">
                    Hiện chưa có câu hỏi nào. Hãy tạo mới nhé!
                </div>
            <% } %>
        </div>
    </div>
</body>
</html>