<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Question Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <!-- Thanh Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" href="#">Question Bank Management Application</a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" href="/ui/quizzes">Quizzes Management</a></li>
                    <li class="nav-item"><a class="nav-link active" href="/ui/questions">Questions Management</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-5">
        
        <!-- THÔNG BÁO TẠO MỚI, CHỈNH SỬA, XÓA -->
        <% if (typeof showCreated !== 'undefined' && showCreated) { %>
            <div id="createQuestionAlert" class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                <strong>Thành công!</strong> Đã thêm câu hỏi mới thành công.
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
            <script>setTimeout(function() { var box = document.getElementById('createQuestionAlert'); if (box) { box.classList.remove('show'); setTimeout(function() { box.remove(); }, 150); } }, 1000);</script>
        <% } %>
        <% if (typeof showDeleted !== 'undefined' && showDeleted) { %>
            <div id="deleteQuestionAlert" class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                <strong>Thành công!</strong> Đã xóa câu hỏi thành công.
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
            <script>setTimeout(function() { var box = document.getElementById('deleteQuestionAlert'); if (box) { box.classList.remove('show'); setTimeout(function() { box.remove(); }, 150); } }, 1000);</script>
        <% } %>
        <% if (typeof showUpdated !== 'undefined' && showUpdated) { %>
            <div id="updateQuestionAlert" class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                <strong>Thành công!</strong> Đã chỉnh sửa câu hỏi thành công.
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
            <script>setTimeout(function() { var box = document.getElementById('updateQuestionAlert'); if (box) { box.classList.remove('show'); setTimeout(function() { box.remove(); }, 150); } }, 1000);</script>
        <% } %>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>Questions</h1>
            <a href="/ui/questions/create" class="btn btn-primary">Create New Question</a>
        </div>
        
        <!-- THANH TÌM KIẾM CÂU HỎI -->
        <div class="mb-4">
            <input type="text" id="searchInput" class="form-control form-control-lg border-primary" placeholder="🔍 Nhập từ khóa để tìm kiếm câu hỏi..." onkeyup="filterQuestions()">
        </div>

        <div class="list-group shadow-sm" id="questionList">
            <% questions.forEach(function(question) { %>
                <!-- Gắn thêm class 'question-item' để JavaScript nhận diện khi lọc -->
                <div class="list-group-item d-flex justify-content-between align-items-center p-3 question-item">
                    <div>
                        <h5 class="mb-1 text-primary"><%= question.text || question.questionText || 'Câu hỏi chưa có nội dung' %></h5>
                    </div>
                    <div>
                        <a href="/ui/questions/<%= question._id %>" class="btn btn-sm btn-info text-white">Details</a>
                        <a href="/ui/questions/<%= question._id %>/edit" class="btn btn-sm btn-warning text-dark">Edit</a>
                        <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal<%= question._id %>">
                            Delete
                        </button>
                    </div>
                </div>

                <!-- HỘP THOẠI MODAL XÓA DÀNH RIÊNG CHO TỪNG CÂU HỎI -->
                <div class="modal fade" id="deleteModal<%= question._id %>" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title text-danger" id="deleteModalLabel">Xác nhận xóa</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                Bạn có chắc chắn muốn xóa câu hỏi <strong>"<%= question.text || question.questionText || 'này' %>"</strong> không? Hành động này không thể hoàn tác.
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                <form action="/ui/questions/<%= question._id %>?_method=DELETE" method="POST" class="d-inline">
                                    <button type="submit" class="btn btn-danger">Vâng, Xóa Ngay</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            <% }); %>

            <% if (questions.length === 0) { %>
                <div class="list-group-item text-center text-muted p-4">
                    Hiện chưa có câu hỏi nào. Hãy tạo mới nhé!
                </div>
            <% } %>
        </div>
    </div>

    <!-- SCRIPT CHỨC NĂNG LỌC CÂU HỎI -->
    <script>
        function filterQuestions() {
            // Lấy từ khóa người dùng gõ và chuyển thành chữ thường
            var input = document.getElementById('searchInput').value.toLowerCase();
            // Lấy tất cả các thẻ div chứa câu hỏi
            var items = document.getElementsByClassName('question-item');
            
            for (var i = 0; i < items.length; i++) {
                // Lấy nội dung chữ của câu hỏi
                var title = items[i].querySelector('h5').innerText.toLowerCase();
                
                // Kiểm tra xem nội dung câu hỏi có chứa từ khóa không
                if (title.includes(input)) {
                    // Nếu có: Hiện câu hỏi (dùng d-flex của bootstrap)
                    items[i].classList.remove('d-none');
                    items[i].classList.add('d-flex');
                } else {
                    // Nếu không: Ẩn câu hỏi (dùng d-none)
                    items[i].classList.remove('d-flex');
                    items[i].classList.add('d-none');
                }
            }
        }
    </script>

    <!-- Nhúng Javascript của Bootstrap -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>