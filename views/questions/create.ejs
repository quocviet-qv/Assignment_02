<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Create Question</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container mt-5">
        <h1 class="mb-4">Create New Question</h1>
        <div class="card shadow-sm p-4">
            <form action="/ui/questions" method="POST">
                <div class="mb-3">
                    <label for="text" class="form-label">Question Text:</label>
                    <input type="text" class="form-control" id="text" name="text" required>
                </div>
                <div class="mb-3">
                    <label for="options" class="form-label">Options (comma separated - vd: Paris, London, Berlin):</label>
                    <input type="text" class="form-control" id="options" name="options" required>
                </div>
                <div class="mb-3">
                    <label for="correctAnswerIndex" class="form-label">Correct Answer Index (0, 1, 2...):</label>
                    <input type="number" class="form-control" id="correctAnswerIndex" name="correctAnswerIndex" required>
                </div>
                <button type="submit" class="btn btn-primary">Create</button>
                <a href="/ui/questions" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</body>
</html>