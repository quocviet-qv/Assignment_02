<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Question Details</title>
    <!-- Nhúng CSS Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <!-- Thanh Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" href="#">Question Bank Management Application</a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" href="/ui/quizzes">Quizzes Management</a></li>
                    <li class="nav-item"><a class="nav-link active" href="/ui/questions">Questions Management</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-5">
        <h1 class="mb-4">Question Details</h1>
        
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Question Information</h4>
            </div>
            <div class="card-body">
                <h5 class="card-title text-primary mb-4">
                    <%= question.text || question.questionText || 'No content provided' %>
                </h5>
                
                <p class="text-muted"><strong>Question ID:</strong> <%= question._id %></p>
                
                <hr>
                <div class="mt-4">
                    <a href="/ui/questions" class="btn btn-secondary">Back to List</a>
                    <a href="/ui/questions/<%= question._id %>/edit" class="btn btn-warning text-dark">Edit Question</a>
                </div>
            </div>
        </div>
    </div>
</body>
</html>