<div class="container mt-5">
    <h1 class="mb-4">Question Details</h1>
    
    <div class="card shadow-sm border-primary">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Question Information</h4>
        </div>
        <div class="card-body p-4">
            <h5 class="card-title text-primary mb-4 fs-4">
                <%= question.text || question.questionText || 'No content provided' %>
            </h5>
            
            <p class="text-muted"><strong>Question ID:</strong> <%= question._id %></p>
            
            <hr class="my-4">
            <div class="mt-2">
                <a href="/ui/questions" class="btn btn-secondary px-4">Back to List</a>
                <a href="/ui/questions/<%= question._id %>/edit" class="btn btn-warning text-dark px-4">Edit Question</a>
            </div>
        </div>
    </div>
</div>