<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Quiz Details</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container mt-5">
        <div class="card shadow-sm p-5">
            <h1 class="text-primary mb-3"><%= quiz.title %></h1>
            <p class="fs-5 text-muted"><%= quiz.description %></p>
            <hr>
            <!-- CODE THÔNG BÁO THÀNH CÔNG -->
            <!-- CODE THÔNG BÁO THÀNH CÔNG -->
            <% if (typeof showSuccess !== 'undefined' && showSuccess) { %>
                <!-- Thêm id="successAlert" để JavaScript có thể tìm thấy -->
                <div id="successAlert" class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                    <strong>Thành công!</strong> Đã thêm câu hỏi vào bài Quiz.
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>

                <!-- JavaScript tự động tắt thông báo -->
                <script>
                    setTimeout(function() {
                        var alertBox = document.getElementById('successAlert');
                        if (alertBox) {
                            // Gỡ class 'show' để kích hoạt hiệu ứng mờ dần của Bootstrap
                            alertBox.classList.remove('show');
                            // Đợi 150ms cho hiệu ứng mờ chạy xong rồi xóa hẳn thẻ khỏi giao diện
                            setTimeout(function() {
                                alertBox.remove();
                            }, 150);
                        }
                    }, 1000); // 1000 mili-giây = 1 giây
                </script>
            <% } %>
            <!-- HIỂN THỊ DANH SÁCH CÂU HỎI TRONG QUIZ -->
            <div class="mt-4 mb-4">
                <h4>Questions in this Quiz:</h4>
                
                <% if (quiz.questions && quiz.questions.length > 0) { %>
                    <ul class="list-group mb-4">
                        <% quiz.questions.forEach(function(q) { %>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <!-- Hỗ trợ hiển thị nếu q là Object câu hỏi hoặc chỉ là ID -->
                                <span><%= q.text || q.questionText || 'Câu hỏi ID: ' + q %></span>
                            </li>
                        <% }); %>
                    </ul>
                <% } else { %>
                    <p class="text-muted fst-italic mb-4">Chưa có câu hỏi nào được thêm vào bài Quiz này.</p>
                <% } %>

                <!-- FORM THÊM CÂU HỎI MỚI VÀO QUIZ -->
                <div class="card p-3 bg-white border-primary">
                    <h5 class="text-primary">Add an existing Question to this Quiz</h5>
                    <form action="/ui/quizzes/<%= quiz._id %>/add-question" method="POST" class="d-flex gap-3 mt-2">
                        <select name="questionId" class="form-select" required>
                            <option value="" disabled selected>-- Chọn câu hỏi có sẵn từ kho --</option>
                            <% allQuestions.forEach(function(question) { %>
                                <option value="<%= question._id %>"><%= question.text || question.questionText %></option>
                            <% }); %>
                        </select>
                        <button type="submit" class="btn btn-success px-4">Add</button>
                    </form>
                </div>
            </div>

            <div class="mt-4">
                <a href="/ui/quizzes" class="btn btn-secondary">Back to List</a>
                <a href="/ui/quizzes/<%= quiz._id %>/edit" class="btn btn-warning text-dark">Edit Quiz</a>
            </div>
        </div>
    </div>
</body>
</html>