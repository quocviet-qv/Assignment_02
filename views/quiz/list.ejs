<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quiz Management</title>
    <!-- Nhúng Bootstrap 5 theo đúng yêu cầu đề bài -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container">
        <a class="navbar-brand" href="#">SimpleQuiz App</a>
        <div class="collapse navbar-collapse">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link" href="/ui/quizzes">Quizzes Management</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/ui/questions">Questions Management</a>
                </li>
            </ul>
        </div>
    </div>
</nav>
    <div class="container mt-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>Quizzes</h1>
            <a href="/ui/quizzes/create" class="btn btn-primary">Create New Quiz</a>
        </div>
        
        <!-- Danh sách các bài Quiz -->
        <div class="list-group shadow-sm">
            <!-- Vòng lặp EJS: duyệt qua mảng dữ liệu lấy từ API -->
            <% quizzes.forEach(function(quiz) { %>
                <div class="list-group-item d-flex justify-content-between align-items-center p-3">
                    <div>
                        <h5 class="mb-1 text-primary"><%= quiz.title %></h5>
                        <p class="mb-1 text-muted"><%= quiz.description %></p>
                    </div>
                    <div>
                        <a href="/ui/quizzes/<%= quiz._id %>" class="btn btn-sm btn-info text-white">Details</a>
                        <a href="/ui/quizzes/<%= quiz._id %>/edit" class="btn btn-sm btn-warning text-dark">Edit</a>
                        
                        <!-- Form này tận dụng method-override để gửi lệnh xóa (DELETE) -->
                        <form action="/ui/quizzes/<%= quiz._id %>?_method=DELETE" method="POST" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Bạn có chắc muốn xóa bài Quiz này?')">Delete</button>
                        </form>
                    </div>
                </div>
            <% }); %>
            
            <% if (quizzes.length === 0) { %>
                <div class="list-group-item text-center text-muted p-4">
                    Hiện chưa có bài Quiz nào. Hãy tạo mới nhé!
                </div>
            <% } %>
        </div>
    </div>
</body>
</html>